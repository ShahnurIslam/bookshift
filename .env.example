# BookShift Docker deployment — copy to .env and adjust for your host.
# All keys are optional; defaults match docker-compose.yml and Dockerfile.

# SQLite pipeline state (writable volume mount)
BOOKSHIFT_DB_PATH=/data/pipeline_state.db
BOOKSHIFT_DATA_DIR=/data

# Read-only library mount (EPUBs + audiobook media)
BOOKSHIFT_BOOKS_DIR=/library
BOOKSHIFT_AUDIOBOOKS_DIR=/library

# Host-side directory for optional coarse/fine locator JSON artifacts
BOOKSHIFT_ARTIFACTS_DIR=./data/benchmarks/artifacts

# Sync API bind (inside container bookshift-core listens on 0.0.0.0:18001)
BOOKSHIFT_SYNC_HOST=0.0.0.0
BOOKSHIFT_SYNC_PORT=18001

# External services (use host.docker.internal on Docker Desktop / Linux 20.10+)
BOOKSHIFT_ABS_URL=http://host.docker.internal:13378
BOOKSHIFT_ABS_TOKEN=

BOOKSHIFT_BOOKORBIT_URL=http://host.docker.internal:3010
BOOKSHIFT_BOOKORBIT_USERNAME=
BOOKSHIFT_BOOKORBIT_PASSWORD=

BOOKSHIFT_M1_WHISPER_URL=http://whisper-host:8000

BOOKSHIFT_STORYTELLER_URL=http://host.docker.internal:18002
BOOKSHIFT_STORYTELLER_DB_PATH=/data/storyteller.db
