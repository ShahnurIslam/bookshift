# BookShift example configuration. Copy to .env for Docker Compose, replace
# every example.invalid URL, and never commit the populated file.

# API/container state. docker-compose.yml overrides these paths inside the
# container; a host runner must use the absolute host path to the same database.
BOOKSHIFT_DB_PATH=/data/pipeline_state.db
BOOKSHIFT_BOOKS_DIR=/library
BOOKSHIFT_AUDIOBOOKS_DIR=/library
BOOKSHIFT_ANALYSIS_DIR=/data/benchmarks/artifacts

# BookShift sync API. Port 18001 is BookShift's documented default.
BOOKSHIFT_SYNC_HOST=0.0.0.0
BOOKSHIFT_SYNC_PORT=18001

# Docker Compose bind source for generated locator artifacts.
BOOKSHIFT_ARTIFACTS_DIR=./data/benchmarks/artifacts

# Required by the host reconciliation runner.
BOOKSHIFT_ABS_URL=https://audiobookshelf.example.invalid
BOOKSHIFT_ABS_TOKEN=
BOOKSHIFT_BOOKORBIT_URL=https://bookorbit.example.invalid
BOOKSHIFT_BOOKORBIT_USERNAME=
BOOKSHIFT_BOOKORBIT_PASSWORD=

# Optional read-only fallback for resolving an ABS token locally. Prefer an
# explicit BOOKSHIFT_ABS_TOKEN. Leave unset unless the host can read this DB.
# BOOKSHIFT_ABS_DB_PATH=/absolute/path/to/absdatabase.sqlite

# Optional alignment services. They are not required for an already-built
# COARSE/FINE index or for running the reconciliation loop.
BOOKSHIFT_M1_WHISPER_URL=https://whisper.example.invalid
BOOKSHIFT_STORYTELLER_URL=https://storyteller.example.invalid
BOOKSHIFT_STORYTELLER_USERNAME=
BOOKSHIFT_STORYTELLER_PASSWORD=
# BOOKSHIFT_STORYTELLER_DB_PATH=/absolute/path/to/storyteller.sqlite

# Optional: point Settings.load() at a dotenv file. A systemd EnvironmentFile
# exports variables directly and does not require this setting.
# BOOKSHIFT_CONFIG_PATH=/absolute/path/to/bookshift.env
